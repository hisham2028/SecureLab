# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://securelab:securelab@localhost:5432/securelab?schema=public
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_TTL_SECONDS=3600
# Judge0 runs in its own containers, never in this process.
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
# Comma-separated origins allowed to call the API (host dashboard dev server).
CORS_ORIGINS=http://localhost:5173
# Used only by `pnpm db:seed` to create the first admin.
SEED_ADMIN_EMAIL=admin@example.edu
SEED_ADMIN_PASSWORD=change-me-now
