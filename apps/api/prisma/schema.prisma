// SecureLab schema.
// Phase 1: institutions, staff identities, audit trail.
// Phase 2: exams, versioned question bank, exam question snapshots, students, registrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StaffRole {
  ADMIN
  HOST
  INVIGILATOR
}

model Institution {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  slug      String      @unique
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  staff     StaffUser[]
  auditLogs AuditLog[]
  exams     Exam[]
  questions Question[]
  students  Student[]

  @@map("institutions")
}

model StaffUser {
  id            String      @id @default(uuid()) @db.Uuid
  institutionId String      @map("institution_id") @db.Uuid
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  email         String      @unique
  displayName   String      @map("display_name")
  passwordHash  String      @map("password_hash")
  role          StaffRole
  isActive      Boolean     @default(true) @map("is_active")
  lastLoginAt   DateTime?   @map("last_login_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([institutionId])
  @@map("staff_users")
}

// Append-only. The application never updates or deletes rows here.
model AuditLog {
  id            BigInt       @id @default(autoincrement())
  institutionId String?      @map("institution_id") @db.Uuid
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  actorType     String       @map("actor_type") // "staff" | "student" | "system"
  actorId       String?      @map("actor_id")
  action        String
  targetType    String?      @map("target_type")
  targetId      String?      @map("target_id")
  metadata      Json?
  correlationId String?      @map("correlation_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([institutionId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  RUNNING
  PAUSED
  COMPLETED
  ARCHIVED
}

enum Language {
  c
  cpp
  python
}

enum AiMode {
  DISABLED
  HINTS_ONLY
  FULL
}

enum NavigationPolicy {
  FREE
  SEQUENTIAL
}

/// How a program's output is compared with a test's expected output.
enum ComparisonMode {
  /// Byte-for-byte after normalizing line endings.
  EXACT
  /// Ignores trailing spaces on each line and trailing blank lines.
  WHITESPACE
}

/// How passed tests turn into a question score.
enum ScoringMode {
  /// Points in proportion to the weight of passed tests.
  WEIGHTED
  /// Full points only when every test passes.
  ALL_OR_NOTHING
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Exam {
  id                        String             @id @default(uuid()) @db.Uuid
  institutionId             String             @map("institution_id") @db.Uuid
  institution               Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdById               String             @map("created_by_id") @db.Uuid
  title                     String
  instructions              String             @default("")
  status                    ExamStatus         @default(DRAFT)
  /// Short code students type to find the exam. Unique while the exam exists.
  accessCode                String             @unique @map("access_code")
  durationMinutes           Int                @map("duration_minutes")
  scheduledStartAt          DateTime?          @map("scheduled_start_at")
  /// Minutes after the actual start during which students may still sign in.
  lateEntryMinutes          Int                @default(15) @map("late_entry_minutes")
  allowEarlySubmit          Boolean            @default(true) @map("allow_early_submit")
  /// Host-defined custom student ID rule (validated by @securelab/shared StudentIdRuleSchema).
  studentIdRule             Json               @map("student_id_rule")
  allowedLanguages          Language[]         @map("allowed_languages")
  navigationPolicy          NavigationPolicy   @default(FREE) @map("navigation_policy")
  maxSubmissionsPerQuestion Int                @default(10) @map("max_submissions_per_question")
  /// When true, students see each submission's verdict and passed-test count during the exam.
  /// Scores are never shown before results are published.
  showSubmissionVerdicts    Boolean            @default(false) @map("show_submission_verdicts")
  /// Upper bound for AI help in this exam; a question can only be stricter.
  aiMode                    AiMode             @default(DISABLED) @map("ai_mode")
  /// Server-authoritative timing. All times are server clock.
  startedAt                 DateTime?          @map("started_at")
  pausedAt                  DateTime?          @map("paused_at")
  pausedSeconds             Int                @default(0) @map("paused_seconds")
  completedAt               DateTime?          @map("completed_at")
  /// Optimistic concurrency token; bumped on every update.
  revision                  Int                @default(1)
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  questions                 ExamQuestion[]
  registrations             ExamRegistration[]

  @@index([institutionId, status])
  @@map("exams")
}

/// Bank entry. Content lives in immutable QuestionVersion rows; editing creates a new version.
model Question {
  id            String            @id @default(uuid()) @db.Uuid
  institutionId String            @map("institution_id") @db.Uuid
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdById   String            @map("created_by_id") @db.Uuid
  latestVersion Int               @default(1) @map("latest_version")
  archived      Boolean           @default(false)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  versions      QuestionVersion[]

  @@index([institutionId, archived])
  @@map("questions")
}

/// Immutable. Never updated or deleted once created (enforced by a DB trigger).
model QuestionVersion {
  id               String         @id @default(uuid()) @db.Uuid
  questionId       String         @map("question_id") @db.Uuid
  question         Question       @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version          Int
  title            String
  statement        String
  inputFormat      String         @default("") @map("input_format")
  outputFormat     String         @default("") @map("output_format")
  constraints      String         @default("")
  allowedLanguages Language[]     @map("allowed_languages")
  timeLimitMs      Int            @map("time_limit_ms")
  memoryLimitKb    Int            @map("memory_limit_kb")
  topic            String         @default("")
  difficulty       Difficulty     @default(MEDIUM)
  tags             String[]
  aiMode           AiMode         @default(DISABLED) @map("ai_mode")
  comparisonMode   ComparisonMode @default(WHITESPACE) @map("comparison_mode")
  scoringMode      ScoringMode    @default(WEIGHTED) @map("scoring_mode")
  createdById      String         @map("created_by_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at")
  testCases        TestCase[]
  examQuestions    ExamQuestion[]

  @@unique([questionId, version])
  @@map("question_versions")
}

/// Immutable with its version. Public cases are samples shown to students; hidden cases never leave the server.
model TestCase {
  id                String          @id @default(uuid()) @db.Uuid
  questionVersionId String          @map("question_version_id") @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  ordinal           Int
  isHidden          Boolean         @map("is_hidden")
  input             String
  expectedOutput    String          @map("expected_output")
  weight            Int             @default(1)

  @@unique([questionVersionId, ordinal])
  @@map("test_cases")
}

/// Pins an exam to an exact immutable question version, so later bank edits never change the exam.
model ExamQuestion {
  id                String          @id @default(uuid()) @db.Uuid
  examId            String          @map("exam_id") @db.Uuid
  exam              Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionVersionId String          @map("question_version_id") @db.Uuid
  questionVersion   QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  ordinal           Int
  points            Int

  drafts      StudentDraft[]
  submissions Submission[]

  @@unique([examId, ordinal])
  @@unique([examId, questionVersionId])
  @@index([questionVersionId])
  @@map("exam_questions")
}

/// University identity: one row per real student per institution.
model Student {
  id            String             @id @default(uuid()) @db.Uuid
  institutionId String             @map("institution_id") @db.Uuid
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  /// Normalized custom ID, kept as text so leading zeros survive.
  studentNumber String             @map("student_number")
  fullName      String             @map("full_name")
  createdAt     DateTime           @default(now()) @map("created_at")
  registrations ExamRegistration[]

  @@unique([institutionId, studentNumber])
  @@map("students")
}

/// Exam-attempt identity: a student's seat in one exam, with its own credential.
model ExamRegistration {
  id               String         @id @default(uuid()) @db.Uuid
  examId           String         @map("exam_id") @db.Uuid
  exam             Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String         @map("student_id") @db.Uuid
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Restrict)
  /// Copy of the normalized ID used for the per-exam uniqueness rule.
  examStudentId    String         @map("exam_student_id")
  pinHash          String         @map("pin_hash")
  failedPinCount   Int            @default(0) @map("failed_pin_count")
  lockedAt         DateTime?      @map("locked_at")
  extensionMinutes Int            @default(0) @map("extension_minutes")
  firstEnteredAt   DateTime?      @map("first_entered_at")
  finishedAt       DateTime?      @map("finished_at")
  /// SEQUENTIAL exams: index of the question the student is on (0-based, in ordinal order).
  navigationIndex  Int            @default(0) @map("navigation_index")
  createdAt        DateTime       @default(now()) @map("created_at")
  drafts           StudentDraft[]
  submissions      Submission[]

  @@unique([examId, examStudentId])
  @@index([studentId])
  @@map("exam_registrations")
}

/// Server copy of a student's work in progress: one row per (seat, question, language).
/// `revision` comes from the client and only ever goes up, so a delayed or replayed save
/// can never overwrite newer code.
model StudentDraft {
  id             String           @id @default(uuid()) @db.Uuid
  registrationId String           @map("registration_id") @db.Uuid
  registration   ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  examQuestionId String           @map("exam_question_id") @db.Uuid
  examQuestion   ExamQuestion     @relation(fields: [examQuestionId], references: [id], onDelete: Restrict)
  language       Language
  code           String
  revision       Int
  savedAt        DateTime         @default(now()) @map("saved_at")

  @@unique([registrationId, examQuestionId, language])
  @@map("student_drafts")
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  INTERNAL_ERROR
  /// Some hidden tests passed.
  PARTIAL
}

/// An accepted, immutable snapshot of a student's answer. Only `status` may change later
/// (when grading runs); the code, language and hash are fixed by a database trigger.
model Submission {
  id                 String           @id @default(uuid()) @db.Uuid
  registrationId     String           @map("registration_id") @db.Uuid
  registration       ExamRegistration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  examQuestionId     String           @map("exam_question_id") @db.Uuid
  examQuestion       ExamQuestion     @relation(fields: [examQuestionId], references: [id], onDelete: Restrict)
  /// 1, 2, 3… per seat and question. Unique, so two racing submits can't both take the last slot.
  sequence           Int
  /// Chosen by the client so a retried request after a network drop doesn't submit twice.
  clientSubmissionId String           @map("client_submission_id") @db.Uuid
  language           Language
  code               String
  codeSha256         String           @map("code_sha256")
  status             SubmissionStatus @default(QUEUED)
  /// Filled in by grading. Score is out of the exam question's points.
  score              Decimal?         @db.Decimal(8, 2)
  maxScore           Int?             @map("max_score")
  testsPassed        Int?             @map("tests_passed")
  testsTotal         Int?             @map("tests_total")
  gradedAt           DateTime?        @map("graded_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  job                JudgeJob?
  evaluations        Evaluation[]

  @@unique([registrationId, examQuestionId, sequence])
  @@unique([registrationId, clientSubmissionId])
  @@index([examQuestionId])
  @@map("submissions")
}

enum JudgeJobStatus {
  QUEUED
  RUNNING
  DONE
  /// Gave up after repeated infrastructure failures; a host can queue it again.
  FAILED
}

/// Durable grading queue, one job per submission. Workers claim jobs with
/// SELECT … FOR UPDATE SKIP LOCKED and a lease, so a crashed worker's job is picked up again.
model JudgeJob {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @unique @map("submission_id") @db.Uuid
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  status       JudgeJobStatus @default(QUEUED)
  attempts     Int            @default(0)
  runAfter     DateTime       @default(now()) @map("run_after")
  lockedAt     DateTime?      @map("locked_at")
  lockedBy     String?        @map("locked_by")
  lastError    String?        @map("last_error")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("judge_jobs")
}

enum EvaluationOutcome {
  COMPLETED
  /// The judge itself failed (not the student's code). Retried; never turned into a mark.
  INFRA_ERROR
}

/// One grading attempt of one submission. Append-only. At most one COMPLETED per submission.
model Evaluation {
  id            String            @id @default(uuid()) @db.Uuid
  submissionId  String            @map("submission_id") @db.Uuid
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  attempt       Int
  outcome       EvaluationOutcome
  verdict       SubmissionStatus?
  score         Decimal?          @db.Decimal(8, 2)
  maxScore      Int               @map("max_score")
  testsPassed   Int               @default(0) @map("tests_passed")
  testsTotal    Int               @default(0) @map("tests_total")
  compileOutput String            @default("") @map("compile_output")
  /// Provider, version, language ID, limits, comparison and scoring mode used. Enough to re-run.
  settings      Json
  error         String?
  workerId      String            @map("worker_id")
  startedAt     DateTime          @map("started_at")
  finishedAt    DateTime          @default(now()) @map("finished_at")
  tests         EvaluationTest[]

  @@unique([submissionId, attempt])
  @@map("evaluations")
}

/// Per-test result. Holds verdicts and resource use only, never the program's output.
model EvaluationTest {
  id           String           @id @default(uuid()) @db.Uuid
  evaluationId String           @map("evaluation_id") @db.Uuid
  evaluation   Evaluation       @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  testCaseId   String           @map("test_case_id") @db.Uuid
  ordinal      Int
  weight       Int
  verdict      SubmissionStatus
  passed       Boolean
  timeSeconds  Float?           @map("time_seconds")
  memoryKb     Int?             @map("memory_kb")

  @@unique([evaluationId, ordinal])
  @@map("evaluation_tests")
}
