# SECURELAB_DOMAIN: the name lab PCs and staff use, e.g. exam.cse.example.edu
# SECURELAB_TLS: "internal" (Caddy's own CA; install its root on lab PCs), an email address for
#                Let's Encrypt (public DNS name needed), or "/certs/cert.pem /certs/key.pem" for
#                a certificate from your institution.
{
	# Browsers and apps send no server name (SNI) when the address is an IP, as on a one-machine
	# setup without a DNS name. This picks the right certificate for them.
	default_sni {$SECURELAB_DOMAIN}
}

{$SECURELAB_DOMAIN} {
	tls {$SECURELAB_TLS}
	encode gzip

	handle_path /api/* {
		reverse_proxy api:3000 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		}
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}
}
