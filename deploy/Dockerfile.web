# Host dashboard (static files) behind Caddy, which also terminates HTTPS and proxies /api to
# the API. Students' PCs use https://<domain>/api as their server address.
#   docker build -f deploy/Dockerfile.web -t securelab-web .
FROM node:22.20.0-bookworm-slim AS build
WORKDIR /app
RUN corepack enable
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc* ./
COPY scripts ./scripts
COPY packages/shared/package.json packages/shared/
COPY apps/host/package.json apps/host/
RUN pnpm install --frozen-lockfile --filter @securelab/host...
COPY tsconfig*.json ./
COPY packages/shared packages/shared
COPY apps/host apps/host
RUN pnpm --filter @securelab/host build

FROM caddy:2.8.4-alpine
COPY --from=build /app/apps/host/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
