# Judge0 settings for the judge host. Copy to judge0.env and replace every CHANGE_ME.
POSTGRES_HOST=judge0-db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=CHANGE_ME
REDIS_HOST=judge0-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# Safety defaults. Per-request values from SecureLab may lower these, never raise them.
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_PER_PROCESS_AND_THREAD_TIME_LIMIT=false
ENABLE_PER_PROCESS_AND_THREAD_MEMORY_LIMIT=false
MAX_CPU_TIME_LIMIT=15
MAX_WALL_TIME_LIMIT=30
MAX_MEMORY_LIMIT=512000
MAX_MAX_FILE_SIZE=4096
MAX_PROCESSES_AND_OR_THREADS=64
ENABLE_WAIT_RESULT=true
# Set in any shared environment and pass the same value as JUDGE0_AUTH_TOKEN to the API.
AUTHN_TOKEN=CHANGE_ME
