# Copy to deploy/.env and fill in. Keep the filled-in file off shared drives: it holds secrets.

# The name lab PCs and staff use to reach this server.
SECURELAB_DOMAIN=exam.cse.example.edu
# HTTPS: "internal" (Caddy runs its own certificate authority; install its root certificate on
# lab PCs and staff laptops), an email address for Let's Encrypt (needs a public DNS name), or
# "/certs/cert.pem /certs/key.pem" with your institution's certificate in deploy/certs/.
SECURELAB_TLS=internal

# Generate each with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=

# The Judge0 host (deploy/judge0) and the AUTHN_TOKEN set there.
JUDGE0_URL=http://judge0.cse.example.edu:2358
JUDGE0_AUTH_TOKEN=

# Optional: AI help for students (free, self-hosted). Start the stack with --profile ai and use:
#   AI_BASE_URL=http://ollama:11434/v1
# Or any OpenAI-compatible service (then also set AI_API_KEY). Empty keeps AI help off.
AI_BASE_URL=
AI_MODEL=qwen2.5-coder:7b
AI_API_KEY=

# Optional
JUDGE_WORKER_CONCURRENCY=4
MONITORING_RETENTION_DAYS=90
BACKUP_KEEP_DAYS=30
SECURELAB_VERSION=local
